<%- include('./partials/header') %>

<div class="card-header" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800;">Academic Accelerator Hub</h1>
    <p style="color: var(--text-muted);">Explain concepts two ways, find BTech concept gaps, translate labs, and scope out projects.</p>
  </div>
</div>

<!-- Academics Sub-Navigation Tabs -->
<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1rem;">
  <a href="/academics/explain" class="btn btn-secondary"><i class="fa-solid fa-graduation-cap"></i> Concept Explainer</a>
  <a href="/academics/labs" class="btn btn-secondary"><i class="fa-solid fa-code-fork"></i> Lab-to-Life Translator</a>
  <a href="/academics/project-builder" class="btn btn-secondary"><i class="fa-solid fa-diagram-project"></i> Project Scoper</a>
  <a href="/exams" class="btn btn-secondary active"><i class="fa-solid fa-pen-to-square"></i> One-Night-Before Exams</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<!-- Two Column Layout: Add Exam on Left, Exam Dashboard on Right -->
<div style="display: grid; grid-template-columns: 1fr 2fr; gap: 2rem; align-items: start;">
  
  <!-- Left Side: Add Exam Form -->
  <div class="glass-card">
    <div class="card-header">
      <h3 style="font-weight: 700;"><i class="fa-solid fa-circle-plus" style="color: var(--primary);"></i> Add Sessional / Exam</h3>
    </div>
    
    <form action="/exams" method="POST" style="margin-top: 1rem;">
      <div class="form-group">
        <label for="subject_name" class="form-label">Subject Name *</label>
        <input type="text" id="subject_name" name="subject_name" class="form-control" placeholder="E.g. Operating Systems, DBMS" required>
      </div>

      <div class="form-group">
        <label for="exam_date" class="form-label">Exam Date *</label>
        <input type="date" id="exam_date" name="exam_date" class="form-control" required>
      </div>

      <div class="form-group">
        <label for="high_weightage_topics" class="form-label">High-Weightage Topics (comma-separated) *</label>
        <textarea id="high_weightage_topics" name="high_weightage_topics" class="form-control" rows="3" placeholder="E.g. CPU Scheduling, Semaphores, Page Replacement Algorithms" required></textarea>
        <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 0.25rem;">
          These 80/20 topics cover the majority of BTech exam questions. Resources will be auto-generated for each!
        </div>
      </div>

      <button type="submit" class="btn btn-primary" style="width: 100%; margin-top: 0.5rem;">
        Add Exam Planner <i class="fa-solid fa-pen-to-square"></i>
      </button>
    </form>
  </div>

  <!-- Right Side: Exam Planners Grid -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    
    <div class="glass-card" style="border-top: 4px solid var(--secondary);">
      <div class="card-header">
        <h3 style="font-weight: 700;"><i class="fa-solid fa-clock-rotate-left" style="color: var(--secondary);"></i> BTech "One-Night-Before" Exam Planners</h3>
      </div>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem; margin-bottom: 1.5rem;">
        View countdowns and load vetted YouTube playlists & notes instantly for sessional topics.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1.5rem;">
        <% if (exams && exams.length > 0) { %>
          <% exams.forEach(exam => { %>
            <% 
              const today = new Date();
              today.setHours(0, 0, 0, 0);
              const examDate = new Date(exam.exam_date);
              examDate.setHours(0, 0, 0, 0);
              const diffTime = examDate.getTime() - today.getTime();
              const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
            %>
            
            <div class="glass-card" style="padding: 1.5rem; border-color: rgba(255,255,255,0.06);">
              <div style="display: flex; justify-content: space-between; align-items: start; margin-bottom: 1rem;">
                <div>
                  <h4 style="font-size: 1.25rem; font-weight: 800; color: #fff;"><%= exam.subject_name %></h4>
                  <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.2rem;">
                    Exam Date: <%= new Date(exam.exam_date).toLocaleDateString('en-IN', {day: '2-digit', month: 'short', year: 'numeric'}) %>
                  </p>
                </div>
                
                <div style="display: flex; align-items: center; gap: 0.5rem;">
                  <!-- Countdown Badge -->
                  <% if (diffDays < 0) { %>
                    <span class="badge" style="background: rgba(255,255,255,0.05); color: var(--text-muted);">Completed</span>
                  <% } else if (diffDays === 0) { %>
                    <span class="badge badge-danger">TODAY</span>
                  <% } else if (diffDays === 1) { %>
                    <span class="badge badge-danger">1 Day Left</span>
                  <% } else { %>
                    <span class="badge badge-warning"><%= diffDays %> Days Left</span>
                  <% } %>

                  <form action="/exams/<%= exam.id %>/delete" method="POST" onsubmit="return confirm('Delete this exam planner?');">
                    <button type="submit" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; color: var(--danger); border-color: rgba(239, 68, 68, 0.2);">
                      <i class="fa-solid fa-trash-can"></i>
                    </button>
                  </form>
                </div>
              </div>

              <!-- Prep Status Toggle -->
              <div style="margin-bottom: 1.25rem; display: flex; align-items: center; gap: 0.75rem; font-size: 0.85rem;">
                <span style="color: var(--text-muted); font-weight: 600;">Status:</span>
                <form action="/exams/<%= exam.id %>/status" method="POST" style="display: inline-block;">
                  <select name="status" onchange="this.form.submit()" class="form-control" style="padding: 0.25rem 0.5rem; font-size: 0.8rem; width: auto; background: rgba(255,255,255,0.05);">
                    <option value="not_started" <%= exam.preparation_status === 'not_started' ? 'selected' : '' %>>❌ Not Started</option>
                    <option value="in_progress" <%= exam.preparation_status === 'in_progress' ? 'selected' : '' %>>⏳ In Progress</option>
                    <option value="ready" <%= exam.preparation_status === 'ready' ? 'selected' : '' %>>✅ Ready</option>
                  </select>
                </form>
              </div>

              <!-- 80/20 sessional topics and search links -->
              <div style="border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem;">
                <h5 style="font-weight: 700; font-size: 0.9rem; text-transform: uppercase; color: var(--primary); margin-bottom: 0.75rem;">
                  Syllabus Checklist & Vetted Resources
                </h5>

                <div style="display: flex; flex-direction: column; gap: 0.5rem;">
                  <% exam.topics.forEach((topic, idx) => { %>
                    <% 
                      const res = exam.resources && exam.resources[topic] ? exam.resources[topic] : {};
                    %>
                    <div style="display: flex; justify-content: space-between; align-items: center; padding: 0.5rem 0.75rem; background: rgba(255,255,255,0.01); border: 1px solid var(--border-glass); border-radius: var(--radius-sm);">
                      
                      <div style="display: flex; align-items: center; gap: 0.5rem;">
                        <input type="checkbox" id="examcheck-<%= exam.id %>-<%= idx %>" style="cursor: pointer;" onclick="saveCheckState(this.id)">
                        <label for="examcheck-<%= exam.id %>-<%= idx %>" style="cursor: pointer; font-size: 0.85rem;"><%= topic %></label>
                      </div>

                      <div style="display: flex; gap: 0.5rem;">
                        <% if(res.youtube) { %>
                          <a href="<%= res.youtube %>" target="_blank" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; border-color: rgba(239, 68, 68, 0.3); color: #ef4444;" title="Search YouTube Playlist">
                            <i class="fa-brands fa-youtube"></i> Playlist
                          </a>
                        <% } %>
                        <% if(res.google_notes) { %>
                          <a href="<%= res.google_notes %>" target="_blank" class="btn btn-secondary" style="padding: 0.25rem 0.5rem; font-size: 0.75rem; border-color: rgba(56, 189, 248, 0.3); color: #38bdf8;" title="Search Handwritten Notes PDF">
                            <i class="fa-solid fa-file-pdf"></i> Notes
                          </a>
                        <% } %>
                      </div>

                    </div>
                  <% }) %>
                </div>
              </div>

            </div>
          <% }) %>
        <% } else { %>
          <div style="text-align: center; padding: 3rem 1.5rem; color: var(--text-muted);" class="glass-card">
            <i class="fa-solid fa-pen-to-square" style="font-size: 3rem; margin-bottom: 1rem; color: var(--text-muted); display: block;"></i>
            <p>No exams logged.</p>
            <p style="font-size: 0.8rem; margin-top: 0.5rem;">Use the form on the left to schedule sessional/end-sem exams and automatically generate instant YouTube playlist & notes search guides.</p>
          </div>
        <% } %>
      </div>
      
    </div>
    
  </div>

</div>

<script>
  // Simple localStorage logic to persist check state across reloads
  document.addEventListener('DOMContentLoaded', () => {
    // Set default exam date to tomorrow
    const tomorrowObj = new Date();
    tomorrowObj.setDate(tomorrowObj.getDate() + 1);
    const tomorrow = tomorrowObj.toISOString().split('T')[0];
    document.getElementById('exam_date').value = tomorrow;

    document.querySelectorAll('input[type="checkbox"]').forEach(cb => {
      const isChecked = localStorage.getItem(cb.id) === 'true';
      cb.checked = isChecked;
      if (isChecked) {
        cb.nextElementSibling.style.textDecoration = 'line-through';
        cb.nextElementSibling.style.color = 'var(--text-muted)';
      }
    });
  });

  function saveCheckState(id) {
    const cb = document.getElementById(id);
    localStorage.setItem(id, cb.checked);
    if (cb.checked) {
      cb.nextElementSibling.style.textDecoration = 'line-through';
      cb.nextElementSibling.style.color = 'var(--text-muted)';
    } else {
      cb.nextElementSibling.style.textDecoration = 'none';
      cb.nextElementSibling.style.color = 'var(--text-main)';
    }
  }
</script>

<%- include('./partials/footer') %>
