<%- include('../partials/header') %>

<div class="card-header" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800;">Academic Accelerator Hub</h1>
    <p style="color: var(--text-muted);">Explain concepts two ways, find BTech concept gaps, translate labs, and scope out projects.</p>
  </div>
</div>

<!-- Academics Sub-Navigation Tabs -->
<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1rem;">
  <a href="/academics/explain" class="btn btn-secondary"><i class="fa-solid fa-graduation-cap"></i> Concept Explainer</a>
  <a href="/academics/labs" class="btn btn-secondary active"><i class="fa-solid fa-code-fork"></i> Lab-to-Life Translator</a>
  <a href="/academics/project-builder" class="btn btn-secondary"><i class="fa-solid fa-diagram-project"></i> Project Scoper</a>
  <a href="/exams" class="btn btn-secondary"><i class="fa-solid fa-pen-to-square"></i> One-Night-Before Exams</a>
</div>

<div class="glass-card" style="border-top: 4px solid var(--primary); margin-bottom: 2rem;">
  <div class="card-header">
    <h3 style="font-weight: 700;"><i class="fa-solid fa-laptop-code" style="color: var(--primary);"></i> Lab-to-Life Translator</h3>
  </div>
  <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 0.5rem;">
    Hostel students spend hours writing dry, academic lab files (like Dijkstra implementations in C) that don't look impressive on resumes. 
    This engine **translates standard sessional labs into full-stack production-grade projects** you can add to your GitHub.
  </p>
</div>

<!-- Grid of Lab Translations -->
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 1.5rem;">
  <% if (labsList && labsList.length > 0) { %>
    <% labsList.forEach(lab => { %>
      <div class="glass-card <%= lab.branch === 'CSE' ? 'border-card-primary' : 'border-card-secondary' %>" style="display: flex; flex-direction: column; justify-content: space-between;">
        <div>
          <!-- Branch Badge -->
          <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1rem;">
            <span class="badge <%= lab.branch === 'CSE' ? 'badge-cse' : 'badge-ece' %>">
              <%= lab.branch %> Syllabus
            </span>
            <i class="fa-solid fa-arrows-spin" style="color: var(--text-muted);"></i>
          </div>

          <!-- Academic Lab description -->
          <div style="margin-bottom: 1.25rem;">
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); display: block;">Dry University Syllabus Lab</span>
            <h4 style="font-size: 1rem; font-weight: 700; line-height: 1.4; color: var(--text-main); margin-top: 0.2rem;">
              "<%= lab.academic_lab %>"
            </h4>
          </div>

          <!-- Real World Project translation -->
          <div style="margin-bottom: 1.25rem; background: rgba(255,255,255,0.02); border: 1px solid var(--border-glass); padding: 1rem; border-radius: var(--radius-sm);">
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--success); display: block; margin-bottom: 0.25rem;">
              <i class="fa-solid fa-circle-check"></i> Production-Grade Project Translation
            </span>
            <h4 style="font-size: 1.05rem; font-weight: 800; color: #fff; line-height: 1.3;">
              <%= lab.real_world %>
            </h4>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.5rem; line-height: 1.4;">
              <%= lab.benefit %>
            </p>
          </div>

          <!-- Implementation Milestones -->
          <div style="margin-bottom: 1.5rem;">
            <span style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--text-muted); display: block; margin-bottom: 0.5rem;">GitHub Roadmap Checklists</span>
            <ul style="list-style: none; padding-left: 0; display: flex; flex-direction: column; gap: 0.4rem;">
              <% lab.milestones.forEach(m => { %>
                <li style="font-size: 0.85rem; display: flex; align-items: start; gap: 0.5rem;">
                  <i class="fa-regular fa-square" style="margin-top: 0.2rem; color: var(--primary);"></i>
                  <span><%= m %></span>
                </li>
              <% }) %>
            </ul>
          </div>
        </div>

        <!-- Call to Action -->
        <div style="border-top: 1px solid rgba(255, 255, 255, 0.05); padding-top: 1rem; text-align: center;">
          <form action="/academics/project-builder" method="POST">
            <input type="hidden" name="title" value="<%= lab.real_world %>">
            <input type="hidden" name="description" value="<%= lab.benefit %>">
            <input type="hidden" name="tech_stack" value="<%= lab.branch === 'CSE' ? 'Node.js, Express, React, SQL/NoSQL' : 'JavaScript WebAudio API' %>">
            <input type="hidden" name="difficulty" value="intermediate">
            <button type="submit" class="btn btn-secondary" style="width: 100%; border-color: var(--primary); color: var(--primary);">
              Import Into Project Scoper <i class="fa-solid fa-file-import"></i>
            </button>
          </form>
        </div>

      </div>
    <% }) %>
  <% } %>
</div>

<%- include('../partials/footer') %>
