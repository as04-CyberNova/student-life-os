<%- include('../partials/header') %>

<div class="card-header" style="margin-bottom: 2rem;">
  <div>
    <h1 style="font-size: 2rem; font-weight: 800;">Academic Accelerator Hub</h1>
    <p style="color: var(--text-muted);">Explain concepts two ways, find BTech concept gaps, translate labs, and scope out projects.</p>
  </div>
</div>

<!-- Academics Sub-Navigation Tabs -->
<div style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-bottom: 2rem; border-bottom: 1px solid var(--border-glass); padding-bottom: 1rem;">
  <a href="/academics/explain" class="btn btn-secondary active"><i class="fa-solid fa-graduation-cap"></i> Concept Explainer</a>
  <a href="/academics/labs" class="btn btn-secondary"><i class="fa-solid fa-code-fork"></i> Lab-to-Life Translator</a>
  <a href="/academics/project-builder" class="btn btn-secondary"><i class="fa-solid fa-diagram-project"></i> Project Scoper</a>
  <a href="/exams" class="btn btn-secondary"><i class="fa-solid fa-pen-to-square"></i> One-Night-Before Exams</a>
</div>

<% if (typeof error !== 'undefined' && error) { %>
  <div class="alert alert-danger"><%= error %></div>
<% } %>
<% if (typeof success !== 'undefined' && success) { %>
  <div class="alert alert-success"><%= success %></div>
<% } %>

<!-- Two Column Layout: Explain Concepts on Left, Gap Detector on Right -->
<div style="display: grid; grid-template-columns: 1.5fr 1fr; gap: 2rem; align-items: start;">
  
  <!-- Left Side: Curated Concepts Explainer -->
  <div style="display: flex; flex-direction: column; gap: 1.5rem;">
    <div class="glass-card" style="border-top: 4px solid var(--primary);">
      <div class="card-header">
        <h3 style="font-weight: 700;"><i class="fa-solid fa-graduation-cap" style="color: var(--primary);"></i> "Explain It Two Ways" Core Library</h3>
      </div>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-top: 0.5rem; margin-bottom: 1.5rem;">
        Click on any topic to view explanations tailored for quick exams (Simple) versus engineering placement interviews (Technical).
      </p>

      <% if (subjects && Object.keys(subjects).length > 0) { %>
        <% Object.keys(subjects).forEach(subject => { %>
          <div style="margin-bottom: 1.5rem;">
            <h4 style="font-size: 1rem; font-weight: 700; color: var(--primary); text-transform: uppercase; margin-bottom: 0.75rem; border-bottom: 1px dashed rgba(255, 255, 255, 0.08); padding-bottom: 0.25rem;">
              <%= subject %>
            </h4>
            <div style="display: flex; flex-direction: column; gap: 0.75rem;">
              <% subjects[subject].forEach(concept => { %>
                <div class="glass-card concept-card" style="padding: 1rem; cursor: pointer; border-color: rgba(255, 255, 255, 0.04);" data-id="<%= concept.id %>">
                  <div style="display: flex; justify-content: space-between; align-items: center;">
                    <span style="font-weight: 600;"><%= concept.topic %></span>
                    <i class="fa-solid fa-chevron-down" id="chevron-<%= concept.id %>" style="font-size: 0.8rem; color: var(--text-muted); transition: transform 0.2s;"></i>
                  </div>

                  <div id="content-<%= concept.id %>" style="display: none; margin-top: 1rem; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 1rem;">
                    <!-- Simple Explanation -->
                    <div style="margin-bottom: 1.25rem; background: rgba(99, 102, 241, 0.05); padding: 1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--primary);">
                      <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--primary); margin-bottom: 0.4rem;">
                        <i class="fa-solid fa-baby"></i> Simple Explanation (ELI5)
                      </div>
                      <p style="font-size: 0.9rem; line-height: 1.5;"><%= concept.simple_explanation %></p>
                    </div>

                    <!-- Technical Explanation -->
                    <div style="margin-bottom: 1.25rem; background: rgba(168, 85, 247, 0.05); padding: 1rem; border-radius: var(--radius-sm); border-left: 3px solid var(--secondary);">
                      <div style="font-size: 0.75rem; text-transform: uppercase; font-weight: 700; color: var(--secondary); margin-bottom: 0.4rem;">
                        <i class="fa-solid fa-briefcase"></i> Technical Explanation (Interviewer Ready)
                      </div>
                      <p style="font-size: 0.9rem; line-height: 1.5;"><%= concept.technical_explanation %></p>
                    </div>

                    <!-- Form to flag as Gap -->
                    <form action="/academics/gaps" method="POST" style="text-align: right;" onclick="event.stopPropagation();">
                      <input type="hidden" name="concept_id" value="<%= concept.id %>">
                      <button type="submit" class="btn btn-secondary" style="font-size: 0.8rem; padding: 0.4rem 0.8rem; border-color: var(--secondary); color: var(--secondary);">
                        Log in Gap Detector <i class="fa-solid fa-circle-exclamation"></i>
                      </button>
                    </form>
                  </div>
                </div>
              <% }) %>
            </div>
          </div>
        <% }) %>
      <% } else { %>
        <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
          No curated concepts seeded in the database. Please run the DB configuration.
        </div>
      <% } %>
    </div>
  </div>

  <!-- Right Side: Concept Gap Detector list -->
  <div style="display: flex; flex-direction: column; gap: 2rem;">
    <div class="glass-card" style="border-top: 4px solid var(--secondary);">
      <div class="card-header">
        <h3 style="font-weight: 700;"><i class="fa-solid fa-triangle-exclamation" style="color: var(--secondary);"></i> Concept Gap Detector</h3>
      </div>
      <p style="color: var(--text-muted); font-size: 0.85rem; margin-top: 0.5rem; margin-bottom: 1.5rem;">
        Assess your weak concepts and track study milestones before placement season.
      </p>

      <div style="display: flex; flex-direction: column; gap: 1rem;">
        <% if (gaps && gaps.length > 0) { %>
          <% gaps.forEach(gap => { %>
            <div class="glass-card <%= gap.status === 'mastered' ? 'border-card-success' : (gap.status === 'learning' ? 'border-card-warning' : 'border-card-danger') %>" style="padding: 1rem;">
              <div style="display: flex; justify-content: space-between; align-items: start;">
                <div>
                  <span style="font-size: 0.75rem; color: var(--text-muted); text-transform: uppercase;"><%= gap.subject %></span>
                  <h4 style="font-weight: 700; margin-top: 0.1rem;"><%= gap.topic %></h4>
                </div>
                <div>
                  <% if (gap.status === 'identified') { %>
                    <span class="badge badge-danger">Weak</span>
                  <% } else if (gap.status === 'learning') { %>
                    <span class="badge badge-warning">Learning</span>
                  <% } else { %>
                    <span class="badge badge-success">Mastered</span>
                  <% } %>
                </div>
              </div>

              <% if (gap.quiz_score !== null) { %>
                <div style="margin-top: 0.5rem; font-size: 0.8rem; color: var(--text-main); font-weight: 600;">
                  Last Score: <span class="text-positive"><%= gap.quiz_score %>%</span>
                </div>
              <% } %>

              <!-- Quick Status Updates -->
              <div style="margin-top: 1rem; display: flex; gap: 0.5rem; flex-wrap: wrap;">
                <form action="/academics/gaps/update" method="POST" style="display: inline-block;">
                  <input type="hidden" name="concept_id" value="<%= gap.concept_id %>">
                  <% if (gap.status === 'identified') { %>
                    <input type="hidden" name="status" value="learning">
                    <button type="submit" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;">
                      Start Learning
                    </button>
                  <% } else if (gap.status === 'learning') { %>
                    <input type="hidden" name="status" value="mastered">
                    <button type="submit" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem; border-color: var(--success); color: var(--success);">
                      Mark Mastered
                    </button>
                  <% } else { %>
                    <input type="hidden" name="status" value="identified">
                    <button type="submit" class="btn btn-secondary" style="padding: 0.3rem 0.6rem; font-size: 0.75rem; border-color: var(--danger); color: var(--danger);">
                      Re-flag Gap
                    </button>
                  <% } %>
                </form>

                <!-- Quick Quiz Dummy Simulator Trigger -->
                <button class="btn btn-secondary btn-run-quiz" style="padding: 0.3rem 0.6rem; font-size: 0.75rem;" 
                        data-id="<%= gap.concept_id %>" data-topic="<%= gap.topic %>">
                  Test Knowledge
                </button>
              </div>
            </div>
          <% }) %>
        <% } else { %>
          <div style="text-align: center; padding: 2rem; color: var(--text-muted);">
            <i class="fa-solid fa-circle-check" style="font-size: 2.5rem; margin-bottom: 0.5rem; color: var(--success); display: block;"></i>
            No gaps logged. Everything is crystal clear!
          </div>
        <% } %>
      </div>
    </div>
  </div>

</div>

<!-- Quiz Simulator Dialog Overlay (Interactive UI) -->
<div id="quizModal" style="display: none; position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0,0,0,0.6); z-index: 1000; justify-content: center; align-items: center; padding: 1rem;">
  <div class="glass-card" style="width: 100%; max-width: 480px; padding: 2rem; background: var(--bg-dark); border-color: var(--secondary);">
    <div class="card-header">
      <h3 style="font-weight: 700;"><i class="fa-solid fa-feather-pointed"></i> Quick Quiz Simulator</h3>
    </div>
    
    <div id="quizBody" style="margin-top: 1rem;">
      <h4 id="quizTopic" style="font-weight: 700; margin-bottom: 0.5rem;">Topic</h4>
      <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 1.25rem;">Assess your understanding. What is the fundamental optimization target or problem addressed by this topic?</p>
      
      <div style="display: flex; flex-direction: column; gap: 0.75rem;">
        <button class="btn btn-secondary choice-btn" onclick="submitQuizScore(100)" style="justify-content: flex-start; text-align: left;">
          Option A: It optimizes throughput and reduces runtime resource usage. (Correct)
        </button>
        <button class="btn btn-secondary choice-btn" onclick="submitQuizScore(50)" style="justify-content: flex-start; text-align: left;">
          Option B: It is just an abstract representation with no real physical performance benefit.
        </button>
        <button class="btn btn-secondary choice-btn" onclick="submitQuizScore(0)" style="justify-content: flex-start; text-align: left;">
          Option C: It creates infinite deadlock blocks on database layers. (Incorrect)
        </button>
      </div>
    </div>

    <!-- Hidden form for saving score -->
    <form id="quizForm" action="/academics/gaps/update" method="POST" style="display: none;">
      <input type="hidden" name="concept_id" id="quizConceptId" value="">
      <input type="hidden" name="status" value="mastered">
      <input type="hidden" name="quiz_score" id="quizScoreVal" value="">
    </form>

    <div style="display: flex; justify-content: flex-end; margin-top: 1.5rem;">
      <button type="button" class="btn btn-secondary" onclick="closeQuizModal()">Cancel</button>
    </div>
  </div>
</div>

<script>
  function toggleConcept(id) {
    const content = document.getElementById(`content-${id}`);
    const chevron = document.getElementById(`chevron-${id}`);
    if (content.style.display === 'none') {
      content.style.display = 'block';
      chevron.style.transform = 'rotate(180deg)';
    } else {
      content.style.display = 'none';
      chevron.style.transform = 'rotate(0deg)';
    }
  }

  // Quiz Modal interactions
  document.addEventListener('DOMContentLoaded', () => {
    // Bind concept cards toggle click event
    document.querySelectorAll('.concept-card').forEach(card => {
      card.addEventListener('click', () => {
        const id = card.dataset.id;
        toggleConcept(id);
      });
    });

    document.querySelectorAll('.btn-run-quiz').forEach(btn => {
      btn.addEventListener('click', () => {
        const id = btn.dataset.id;
        const topic = btn.dataset.topic;
        openQuizModal(id, topic);
      });
    });
  });

  function openQuizModal(id, topic) {
    document.getElementById('quizConceptId').value = id;
    document.getElementById('quizTopic').innerText = `Concept assessment: ${topic}`;
    document.getElementById('quizModal').style.display = 'flex';
  }

  function closeQuizModal() {
    document.getElementById('quizModal').style.display = 'none';
  }

  function submitQuizScore(score) {
    document.getElementById('quizScoreVal').value = score;
    document.getElementById('quizForm').submit();
  }
</script>

<%- include('../partials/footer') %>
